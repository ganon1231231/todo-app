# Dr.Coach! — configuración de edición consistente
# (los editores modernos lo leen automáticamente)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{command,sh}]
# los launchers y scripts de shell conservan su salto de línea final
insert_final_newline = true
